{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "../shared/**/*.ts"],
	"comment": "node-server.ts targets the Node runtime (tsx), not the Workers types — typechecked separately at runtime.",
	"exclude": ["src/node-server.ts"]
}
